  {
   "type": "table",
   "title": "Tokens per book",
   "id": 13,
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "questions"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "questions"
     },
     "refId": "A",
     "rawSql": "SELECT book AS \"Book\", count(*) AS \"Answers\", sum(total_tokens) AS \"Tokens\", round(avg(total_tokens)) AS \"Average\" FROM reporting.questions WHERE $__timeFilter(created_at) AND total_tokens IS NOT NULL GROUP BY book ORDER BY 3 DESC",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "gridPos": {
