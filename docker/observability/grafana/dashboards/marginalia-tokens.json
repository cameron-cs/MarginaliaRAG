  {
   "type": "timeseries",
   "title": "Generation speed (tokens per second)",
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le, role) (rate(marginalia_llm_tokens_per_second_bucket[30m])))",
     "legendFormat": "{{role}} median",
     "refId": "A",
     "instant": false,
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.05, sum by (le, role) (rate(marginalia_llm_tokens_per_second_bucket[30m])))",
     "legendFormat": "{{role}} slowest 5%",
     "refId": "B",
     "instant": false,
     "range": true
    }
   ],
