   "title": "Answer tokens: prompt and completion",
   "id": 15,
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "questions"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "questions"
     },
     "refId": "A",
     "rawSql": "SELECT $__timeGroupAlias(created_at, '1h'), sum(prompt_tokens) AS prompt, sum(completion_tokens) AS completion FROM reporting.questions WHERE $__timeFilter(created_at) AND total_tokens IS NOT NULL GROUP BY 1 ORDER BY 1",
