  {
   "type": "timeseries",
   "title": "Tokens per reader over time",
   "id": 14,
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "questions"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "questions"
     },
     "refId": "A",
     "rawSql": "SELECT $__timeGroupAlias(created_at, '1h'), reader AS metric, sum(total_tokens) AS value FROM reporting.questions WHERE $__timeFilter(created_at) AND total_tokens IS NOT NULL GROUP BY 1, 2 ORDER BY 1",
     "format": "time_series",
     "rawQuery": true,
