# Copy to .env. Read by docker-compose.yml and by marginalia/config.py, so both sides agree.
# Real environment variables override this file. Names carry a CP_ prefix so OLLAMA_*
# variables set globally for another Ollama do not change this project.

# --- Ollama server (docker compose up -d ollama to apply) ---
CP_OLLAMA_PORT=11435
# Requests served at once; also the eval runner's default --concurrency.
# Measured on the RTX 5080, qwen3:4b, 16k context, 8 thinking requests (2026-10-22):
#   slots  kv     total tok/s  per-request tok/s  model memory
#   1      f16    162          162                5.3 GB
#   2      f16    162           82                7.8 GB
#   3      f16    184           70
#   4      f16    224           61                12 GB
#   4      q8_0   201           51                8.1 GB
# 4 slots needs the GPU mostly to itself: unload pronet's models first. If memory is short,
# use 4 + q8_0, or 1 (2 gives no throughput gain).
CP_OLLAMA_NUM_PARALLEL=4
CP_OLLAMA_FLASH_ATTENTION=1
# f16 | q8_0 | q4_0 (q8_0/q4_0 need flash attention; q8_0 halves KV memory but decodes slower)
CP_OLLAMA_KV_CACHE_TYPE=f16
CP_OLLAMA_KEEP_ALIVE=30m
CP_OLLAMA_MAX_LOADED_MODELS=1

# --- Backend (Postgres, Redis, API) ---
# development | production (production refuses to start without CP_JWT_SECRET)
CP_ENV=development
CP_POSTGRES_PORT=5440
CP_POSTGRES_PASSWORD=marginalia
CP_REDIS_PORT=6390
CP_API_PORT=8010
# Signs access tokens. Required outside development; generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CP_JWT_SECRET=
# The web UI's admin: the API creates this account at start (or makes it an admin and sets this
# password). Change the password here and restart to reset it. Leave the email empty for none.
CP_ADMIN_EMAIL=admin@example.com
CP_ADMIN_PASSWORD=change-me
# A reader account for the README screenshots (docs/screenshots/capture.py signs it up if needed).
CP_DEMO_EMAIL=demo@example.com
CP_DEMO_PASSWORD=change-me
CP_ACCESS_TOKEN_MINUTES=15
CP_REFRESH_TOKEN_DAYS=14
CP_MAX_UPLOAD_MB=100
# Model that checks owner prompts and writes default personas (the "big" model; any Ollama model).
CP_GUARD_MODEL=qwen3:4b

# --- Running in production ---
# development | production. Production refuses to start on unsafe settings (a short JWT secret,
# cookies without HTTPS, a default Airflow password) and hides the API docs.
# CP_ENV=development
# 1 when the site is served over HTTPS (required in production).
# CP_SECURE_COOKIES=0
# Proxies allowed to set X-Forwarded-For/-Proto (comma-separated IPs, or * behind a trusted proxy).
# CP_FORWARDED_ALLOW_IPS=127.0.0.1
# The interactive API docs at /docs (default: on in development, off in production).
# CP_API_DOCS=1
# Logs: INFO by default; json (one object per line, for Loki) in Docker, text on a terminal.
# CP_LOG_LEVEL=INFO
# CP_LOG_FORMAT=json          (the containers default to json; leave unset for text on a terminal)

# --- Answers: the agent's sampling defaults (readers may override them per question) ---
# CP_AGENT_TEMPERATURE=0.6
# CP_AGENT_TOP_P=0.95
# CP_AGENT_TOP_K=40
# CP_AGENT_MAX_TOOL_CALLS=6

# --- Questions: guard and answer cache (the worker) ---
# Local injection classifier (ONNX, ~740 MB, downloaded on first start); empty turns it off.
# CP_INJECTION_MODEL=protectai/deberta-v3-base-prompt-injection-v2
# CP_INJECTION_THRESHOLD=0.98
# Refuse questions that look less like questions about a book than other requests by this much.
# CP_TOPIC_MARGIN=0.01
# An e5 match to the book's passages at least this close makes a question relevant outright.
# CP_BOOK_MATCH=0.83
# Reuse an earlier answer at this e5 similarity (and the same names, numbers, question word).
# CP_CACHE_SIMILARITY=0.97

# --- Covers ---
# Look covers up on Open Library when the PDF has none (0: offline, generate one instead).
CP_COVERS_ONLINE=1
# CP_COVERS_USER_AGENT=marginalia/0.5 (self-hosted book Q&A; covers lookup)

# --- Observability (docker compose --profile observability up -d) ---
# Grafana on 127.0.0.1:3030 (linked from the admin page), Prometheus on 127.0.0.1:9095.
# CP_GRAFANA_PORT=3030
# CP_PROMETHEUS_PORT=9095
# CP_GRAFANA_URL=http://127.0.0.1:3030
CP_GRAFANA_USER=admin
CP_GRAFANA_PASSWORD=change-me
# The read-only Postgres login Grafana and Evidently use (it sees the `reporting` views only).
CP_REPORTING_DB_PASSWORD=change-me
# LLM monitoring (Evidently UI on 127.0.0.1:8085): the secret the report job writes with.
# CP_EVIDENTLY_PORT=8085
# CP_EVIDENTLY_UI_URL=http://127.0.0.1:8085
CP_EVIDENTLY_SECRET=change-me

# --- Airflow (docker compose --profile airflow up -d) ---
CP_AIRFLOW_PORT=8090
CP_AIRFLOW_USER=admin
CP_AIRFLOW_PASSWORD=change-me
# When Airflow processes uploaded books: a cron expression or preset (@hourly, @daily).
CP_INGEST_SCHEDULE=@hourly
# Encrypts Airflow connections and variables; generate with
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CP_AIRFLOW_FERNET_KEY=
# Signs tokens between Airflow's own components.
CP_AIRFLOW_JWT_SECRET=change-me
# Signs the Airflow UI's sign-in session; must stay the same across restarts. Generate with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CP_AIRFLOW_SECRET_KEY=change-me

# --- Python side (optional overrides) ---
# CP_OLLAMA_URL=http://127.0.0.1:11435
# CP_AGENT_MODEL=qwen3:4b
# CP_AGENT_NUM_CTX=16384
# CP_QDRANT_URL=http://127.0.0.1:6340
