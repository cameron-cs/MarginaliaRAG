   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "questions"
     },
     "refId": "A",
     "rawSql": "SELECT created_at AS \"Asked\", reader AS \"Reader\", book AS \"Book\", left(question, 120) AS \"Question\", total_tokens AS \"Tokens\", agent_tokens AS \"Agent\", grader_tokens AS \"Grader\", searches AS \"Searches\", round(seconds::numeric, 1) AS \"Seconds\", tokens_per_second AS \"Tokens/s\" FROM reporting.questions WHERE $__timeFilter(created_at) AND total_tokens IS NOT NULL ORDER BY total_tokens DESC LIMIT 20",
