  {
   "type": "table",
   "title": "Tokens per reader",
   "id": 12,
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "questions"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "questions"
     },
     "refId": "A",
     "rawSql": "SELECT reader AS \"Reader\", count(*) AS \"Answers\", sum(total_tokens) AS \"Tokens\", round(avg(total_tokens)) AS \"Average\", max(total_tokens) AS \"Most\", min(total_tokens) AS \"Fewest\", round(avg(tokens_per_second)::numeric, 1) AS \"Tokens/s\" FROM reporting.questions WHERE $__timeFilter(created_at) AND total_tokens IS NOT NULL GROUP BY reader ORDER BY 3 DESC",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "gridPos": {
    "h": 9,
    "w": 14,
    "x": 0,
    "y": 14
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
